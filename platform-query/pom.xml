<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.0.6</version>
        <relativePath/>
    </parent>

    <groupId>org.ipro</groupId>
    <artifactId>platform-query</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>GitVaa platform query contract</name>
    <description>
        M1: query backend без UDR DOM, reportstudio и Vaadin. Сюда переехали описание
        запроса (параметры, сортировки, лимиты, computed-значения), контекст запуска,
        визуальный конструктор/парсер/компилятор, каталог метаданных запроса, guard,
        исполнитель, квоты, register-slice рецепты и резолвер параметров. Зависимости —
        только платформенные: platform-core/platform-metadata/platform-rls/platform-register/filtergrid/
        platform-report-core, плюс Hibernate и Jackson. Пакеты reportstudio, org.ip,
        UniDR и Vaadin в этом модуле запрещены гейтом.
    </description>

    <properties>
        <java.version>21</java.version>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.build.outputTimestamp>2026-10-21T00:00:00Z</project.build.outputTimestamp>
        <platform-core.version>1.0-SNAPSHOT</platform-core.version>
        <platform-metadata.version>1.0-SNAPSHOT</platform-metadata.version>
        <platform-rls.version>1.0-SNAPSHOT</platform-rls.version>
        <platform-register.version>1.0-SNAPSHOT</platform-register.version>
        <platform-report-core.version>1.0-SNAPSHOT</platform-report-core.version>
        <filtergrid.version>1.0-SNAPSHOT</filtergrid.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.ipro</groupId>
            <artifactId>platform-core</artifactId>
            <version>${platform-core.version}</version>
        </dependency>
        <dependency>
            <groupId>org.ipro</groupId>
            <artifactId>platform-metadata</artifactId>
            <version>${platform-metadata.version}</version>
        </dependency>
        <dependency>
            <groupId>org.ipro</groupId>
            <artifactId>platform-rls</artifactId>
            <version>${platform-rls.version}</version>
        </dependency>
        <dependency>
            <groupId>org.ipro</groupId>
            <artifactId>platform-register</artifactId>
            <version>${platform-register.version}</version>
        </dependency>
        <dependency>
            <groupId>org.ipro</groupId>
            <artifactId>platform-report-core</artifactId>
            <version>${platform-report-core.version}</version>
        </dependency>
        <dependency>
            <groupId>org.ipro</groupId>
            <artifactId>filtergrid-core</artifactId>
            <version>${filtergrid.version}</version>
        </dependency>
        <dependency>
            <groupId>org.ipro</groupId>
            <artifactId>filtergrid-projection</artifactId>
            <version>${filtergrid.version}</version>
        </dependency>
        <dependency>
            <groupId>org.hibernate.orm</groupId>
            <artifactId>hibernate-core</artifactId>
        </dependency>
        <dependency>
            <groupId>jakarta.persistence</groupId>
            <artifactId>jakarta.persistence-api</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-context</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-tx</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <includes>
                        <include>**/*Test.java</include>
                        <include>**/*IT.java</include>
                    </includes>
                </configuration>
            </plugin>
            <!--
              M1.4: Q6-фикстуры и пять IT принадлежат артефакту, но прикладным
              acceptance-тестам нужны сущности из его тестового дерева. Публикуем
              test-jar; Q6JpaTestConfiguration исключён, иначе на тестовом classpath
              приложения появился бы второй @SpringBootConfiguration и autodetection
              @SpringBootTest нашёл бы две конфигурации.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <executions>
                    <execution>
                        <id>test-jar</id>
                        <goals>
                            <goal>test-jar</goal>
                        </goals>
                        <configuration>
                            <excludes>
                                <exclude>org/ipro/query/q6/Q6JpaTestConfiguration.class</exclude>
                            </excludes>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>

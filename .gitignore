# Versioned architecture sources of truth. Local drafts under docs/plans and
# agent.md remain ignored by the broad rules above.
!JMIX_GitVaa_Roadmap_v2.md
!docs/architecture/
!docs/architecture/**/*.md

# C4.2 snapshot-ресурсы тестов метаданных — часть поставки: EffectiveMetadataSnapshotTest
# сравнивает текущие effective-факты с этими файлами, поэтому на чистом checkout они
# обязаны присутствовать, а не создаваться локальным прогоном.
!src/test/resources/metadata/
!src/test/resources/metadata/*.txt

# C4.8 search-parity baseline — часть поставки: SearchFieldParitySnapshotTest сравнивает
# поисковые поля standard roots с этим файлом, поэтому на чистый checkout он обязан
# присутствовать, а не создаваться локальным прогоном.
!src/test/resources/search/
!src/test/resources/search/*.txt

# D1: reviewed-реестр периметра публичной поверхности (FQN → API / SPI / legacy-internal)
# и матрица допустимых направлений «пакет → пакет» — часть поставки и предмет ревью, а не
# артефакт прогона. PlatformPublicSurfaceTest и PlatformPackageDependencyMatrixTest читают их
# как источник истины, поэтому на чистом checkout они обязаны присутствовать: гейт, чьи
# данные игнорируются VCS, защищает только машину автора.
!src/test/resources/platform-public-surface.txt
!src/test/resources/platform-core-surface.txt
!src/test/resources/platform-rest-surface.txt
!src/test/resources/platform-package-matrix.txt

# D3.5.0: семантический реестр будущего модуля platform-vaadin. Тот же случай, что и в §2.8
# (D3.3): широкое правило `*.txt` исключило бы reviewed-список из поставки, и гейт защищал бы
# только машину автора — на чистом checkout файла просто нет, а тест читает его как источник
# истины. PlatformVaadinSurfaceTest обязан находить его в репозитории.
!src/test/resources/platform-vaadin-surface.txt

# D3.5.7: reviewed-реестр шва Report → Form. Тот же случай, что и выше: широкое правило `*.txt`
# исключило бы контракт шва из поставки, а ReportFormSeamTest читает его как источник истины.
# Здесь это важнее обычного: предмет реестра — подготовка среза D3.6 (что именно уезжает
# вместе со слоем), то есть данные, нужные не машине автора, а следующему шагу.
!src/test/resources/report-form-seam.txt

# E2.0: baseline публичных адресов глубокой ссылки (ADR-0009). Тот же случай, что у
# metadata/search выше: DeepLinkRouteBaselineTest читает файл как источник истины, поэтому
# широкое правило `*.txt` исключило бы контракт из поставки и гейт защищал бы только машину
# автора. Предмет файла — обещание совместимости адресов, то есть данные для читателя, а не
# артефакт прогона.
!src/test/resources/routes/
!src/test/resources/routes/*.txt

# D2/D1: API/ABI baseline публичной поверхности вынесенных артефактов. PlatformApiBaselineTest
# сравнивает с ним подписи, поэтому на чистом checkout он обязан присутствовать.
!src/test/resources/platform-api-baseline/
!src/test/resources/platform-api-baseline/*.api

# D2: README платформенных модулей — часть поставки: они объясняют, почему слой вынесен,
# что в него не попадает и как модуль регистрирует себя контейнеру. Без них граница
# читается только по коду.
# Шаблон, а не перечисление: перечисление уже дважды отставало — README модулей
# platform-rls и platform-telemetry существовали, но в репозиторий не попадали, потому что
# правило *.md выше их исключало, а исключения для них никто не добавил.
!platform-*/README.md


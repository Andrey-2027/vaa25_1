{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ipro:entity-design:entity-draft:4",
  "title": "Portable register draft, envelope v4 with explicit numeric-reference RLS",
  "description": "Structural envelope only. Invalid/incomplete design values are preserved for the semantic validator; register rules are checked by the single semantic validator.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "recipe",
    "draftId",
    "entity",
    "fields",
    "sections",
    "register"
  ],
  "properties": {
    "schemaVersion": {
      "const": 4
    },
    "recipe": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version"
      ],
      "properties": {
        "id": {
          "const": "independent-register-v2"
        },
        "version": {
          "const": 2
        }
      }
    },
    "draftId": {
      "$ref": "#/$defs/id"
    },
    "entity": {
      "$ref": "#/$defs/entity"
    },
    "fields": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "$ref": "#/$defs/field"
      }
    },
    "sections": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "$ref": "#/$defs/section"
      }
    },
    "register": {
      "$ref": "#/$defs/register"
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "text": {
      "type": "string",
      "maxLength": 4096
    },
    "suggestedText": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "text"
      ],
      "properties": {
        "mode": {
          "enum": [
            "AUTO",
            "EXPLICIT"
          ]
        },
        "text": {
          "$ref": "#/$defs/text"
        }
      },
      "if": {
        "properties": {
          "mode": {
            "const": "AUTO"
          }
        },
        "required": [
          "mode"
        ]
      },
      "then": {
        "properties": {
          "text": {
            "const": ""
          }
        }
      }
    },
    "entity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "className",
        "packageName",
        "label",
        "titles",
        "tableName",
        "subsystemId",
        "icon"
      ],
      "properties": {
        "className": {
          "$ref": "#/$defs/text"
        },
        "packageName": {
          "$ref": "#/$defs/suggestedText"
        },
        "label": {
          "$ref": "#/$defs/text"
        },
        "titles": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "list",
            "item",
            "selection"
          ],
          "properties": {
            "list": {
              "$ref": "#/$defs/suggestedText"
            },
            "item": {
              "$ref": "#/$defs/suggestedText"
            },
            "selection": {
              "$ref": "#/$defs/suggestedText"
            }
          }
        },
        "tableName": {
          "$ref": "#/$defs/suggestedText"
        },
        "subsystemId": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/text"
            }
          ]
        },
        "icon": {
          "$ref": "#/$defs/text"
        }
      }
    },
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "label",
        "type",
        "columnName",
        "serverRequired",
        "uiRequired",
        "constraints",
        "reference",
        "applications"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "$ref": "#/$defs/text"
        },
        "label": {
          "$ref": "#/$defs/text"
        },
        "type": {
          "$ref": "#/$defs/text"
        },
        "columnName": {
          "$ref": "#/$defs/suggestedText"
        },
        "serverRequired": {
          "type": "boolean"
        },
        "uiRequired": {
          "enum": [
            "AUTO",
            "REQUIRED",
            "OPTIONAL"
          ]
        },
        "constraints": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "length",
            "precision",
            "scale"
          ],
          "properties": {
            "length": {
              "$ref": "#/$defs/text"
            },
            "precision": {
              "$ref": "#/$defs/text"
            },
            "scale": {
              "$ref": "#/$defs/text"
            }
          }
        },
        "reference": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "typeId"
              ],
              "properties": {
                "typeId": {
                  "$ref": "#/$defs/text"
                }
              }
            }
          ]
        },
        "applications": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "form",
            "list",
            "selection",
            "table"
          ],
          "properties": {
            "form": {
              "type": "boolean"
            },
            "list": {
              "type": "boolean"
            },
            "selection": {
              "type": "boolean"
            },
            "table": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "section": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "rowClassName",
        "packageName",
        "tableName",
        "parentFieldName",
        "parentColumnName",
        "fields"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "label": {
          "$ref": "#/$defs/text"
        },
        "rowClassName": {
          "$ref": "#/$defs/text"
        },
        "packageName": {
          "$ref": "#/$defs/suggestedText"
        },
        "tableName": {
          "$ref": "#/$defs/suggestedText"
        },
        "parentFieldName": {
          "$ref": "#/$defs/suggestedText"
        },
        "parentColumnName": {
          "$ref": "#/$defs/suggestedText"
        },
        "fields": {
          "type": "array",
          "maxItems": 1000,
          "items": {
            "$ref": "#/$defs/field"
          }
        }
      }
    },
    "register": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "period",
        "writeProfile",
        "dimensions",
        "resources",
        "rls"
      ],
      "properties": {
        "period": {
          "$ref": "#/$defs/text"
        },
        "writeProfile": {
          "$ref": "#/$defs/text"
        },
        "dimensions": {
          "type": "array",
          "maxItems": 1000,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "resources": {
          "type": "array",
          "maxItems": 1000,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "rls": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "properties": {
                "dimension": {
                  "$ref": "#/$defs/text"
                },
                "fieldId": {
                  "anyOf": [
                    {
                      "type": "null"
                    },
                    {
                      "$ref": "#/$defs/id"
                    }
                  ]
                }
              },
              "additionalProperties": false,
              "required": [
                "dimension",
                "fieldId"
              ]
            }
          ]
        }
      }
    }
  }
}

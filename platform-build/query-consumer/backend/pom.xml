<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>org.ipro.consumer</groupId>
    <artifactId>query-consumer-backend</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>Query backend negative consumer</name>
    <description>
        M1 step 5: independent backend consumer of platform-query without Vaadin and Jasper.
        The with-query profile is active by default and is deliberately deactivatable:
        `-P!with-query` must make compilation fail, proving that the artifact is required
        rather than accidentally satisfied by the application tree.
    </description>

    <properties>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.build.outputTimestamp>2026-10-24T00:00:00Z</project.build.outputTimestamp>
    </properties>

    <profiles>
        <profile>
            <id>with-query</id>
            <activation>
                <activeByDefault>true</activeByDefault>
            </activation>
            <dependencies>
                <dependency>
                    <groupId>org.ipro</groupId>
                    <artifactId>platform-query</artifactId>
                    <version>1.0-SNAPSHOT</version>
                </dependency>
                <dependency>
                    <groupId>org.ipro</groupId>
                    <artifactId>platform-report-core</artifactId>
                    <version>1.0-SNAPSHOT</version>
                </dependency>
            </dependencies>
        </profile>
    </profiles>
</project>

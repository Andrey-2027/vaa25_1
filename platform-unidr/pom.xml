<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.0.6</version>
        <relativePath/>
    </parent>

    <groupId>org.ipro</groupId>
    <artifactId>platform-unidr</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>GitVaa platform UniDR backend</name>
    <description>
        M2.2.1: backend UniDR — модель определения, файловое хранилище, рендер,
        запуск и query-источник. Пакет org.ipro.unidr. Прикладной источник
        (позиции накладных), JPQL-адаптер и справочник ссылок остаются в приложении:
        модуль знает только UniDrSourceDefinition, UniDrReferenceCatalog и
        UniDrRunQueryAdapter. Vaadin, org.ip, reportstudio и прикладные сущности
        здесь запрещены гейтом.
    </description>

    <properties>
        <java.version>21</java.version>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.build.outputTimestamp>2026-10-24T00:00:00Z</project.build.outputTimestamp>
        <platform-query.version>1.0-SNAPSHOT</platform-query.version>
        <platform-report.version>1.0-SNAPSHOT</platform-report.version>
        <platform-report-core.version>1.0-SNAPSHOT</platform-report-core.version>
        <platform-metadata.version>1.0-SNAPSHOT</platform-metadata.version>
        <platform-rls.version>1.0-SNAPSHOT</platform-rls.version>
        <filtergrid.version>1.0-SNAPSHOT</filtergrid.version>
        <dynamicreports.version>7.0.0-ip.20260813</dynamicreports.version>
        <jasperreports.version>7.0.6</jasperreports.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.ipro</groupId>
            <artifactId>platform-query</artifactId>
            <version>${platform-query.version}</version>
        </dependency>
        <dependency>
            <groupId>org.ipro</groupId>
            <artifactId>platform-report</artifactId>
            <version>${platform-report.version}</version>
        </dependency>
        <dependency>
            <groupId>org.ipro</groupId>
            <artifactId>platform-report-core</artifactId>
            <version>${platform-report-core.version}</version>
        </dependency>
        <dependency>
            <groupId>org.ipro</groupId>
            <artifactId>platform-metadata</artifactId>
            <version>${platform-metadata.version}</version>
        </dependency>
        <dependency>
            <groupId>org.ipro</groupId>
            <artifactId>platform-rls</artifactId>
            <version>${platform-rls.version}</version>
        </dependency>
        <dependency>
            <groupId>org.ipro</groupId>
            <artifactId>filtergrid-core</artifactId>
            <version>${filtergrid.version}</version>
        </dependency>
        <dependency>
            <groupId>org.ipro</groupId>
            <artifactId>filtergrid-projection</artifactId>
            <version>${filtergrid.version}</version>
        </dependency>
        <dependency>
            <groupId>org.hibernate.orm</groupId>
            <artifactId>hibernate-core</artifactId>
        </dependency>
        <dependency>
            <groupId>jakarta.persistence</groupId>
            <artifactId>jakarta.persistence-api</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-context</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-tx</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-web</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.datatype</groupId>
            <artifactId>jackson-datatype-jsr310</artifactId>
        </dependency>
        <dependency>
            <groupId>net.sourceforge.dynamicreports</groupId>
            <artifactId>dynamicreports-core</artifactId>
            <version>${dynamicreports.version}</version>
            <exclusions>
                <exclusion>
                    <groupId>net.sf.jasperreports</groupId>
                    <artifactId>jasperreports-google-maps</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>net.sf.jasperreports</groupId>
            <artifactId>jasperreports</artifactId>
            <version>${jasperreports.version}</version>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <includes>
                        <include>**/*Test.java</include>
                        <include>**/*IT.java</include>
                    </includes>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>

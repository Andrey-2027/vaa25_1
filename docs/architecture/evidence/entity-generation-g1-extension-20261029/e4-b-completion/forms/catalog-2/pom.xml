<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.0.6</version>
        <relativePath/>
    </parent>

    <groupId>com.example</groupId>
    <artifactId>entity-generation-g1-form-catalog-2</artifactId>
    <version>0.1-SNAPSHOT</version>
    <name>G1.2 compile/runtime harness</name>
    <description>
        Изолированный backend-потребитель платформы для G1.2: настоящие platform JAR,
        autoconfiguration, MetadataConsistencyStartupCheck, canonical API и C5, H2.
        Vaadin, forms, browser, PostgreSQL и UI-тесты сюда не входят.
    </description>

    <properties>
        <java.version>21</java.version>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <project.build.outputTimestamp>2026-10-28T00:00:00Z</project.build.outputTimestamp>
        <platform.version>1.0-SNAPSHOT</platform.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.ipro</groupId>
                <artifactId>platform-bom</artifactId>
                <version>${platform.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies><dependency><groupId>org.mockito</groupId><artifactId>mockito-core</artifactId><version>5.20.0</version><scope>test</scope></dependency>
        <dependency>
            <groupId>org.ipro</groupId>
            <artifactId>platform-backend-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <!-- RlsAutoConfiguration introspects a Filter-returning bean method even in a backend-only
             context; the servlet API is needed to load that class, not to start a web server. -->
        <dependency>
            <groupId>jakarta.servlet</groupId>
            <artifactId>jakarta.servlet-api</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
            <exclusions>
                <exclusion>
                    <groupId>org.mockito</groupId>
                    <artifactId>mockito-core</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>org.mockito</groupId>
                    <artifactId>mockito-junit-jupiter</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
    </dependencies>

    <profiles><profile><id>g1-references</id><dependencies><dependency>
        <groupId>org.ipro</groupId><artifactId>g1-reference-target</artifactId><version>1.0-E2</version>
    </dependency><dependency><groupId>org.ipro</groupId><artifactId>platform-vaadin</artifactId><version>${platform.version}</version></dependency>
    <dependency><groupId>com.vaadin</groupId><artifactId>vaadin-core</artifactId><version>25.1.6</version></dependency>
    </dependencies></profile><profile><id>g1-owners</id><dependencies><dependency>
        <groupId>org.ipro</groupId><artifactId>g1-owner-support</artifactId><version>1.0-E3</version>
    </dependency></dependencies></profile><profile><id>g1-sections</id><dependencies><dependency>
        <groupId>org.ipro</groupId><artifactId>g1-reference-target</artifactId><version>1.0-E2</version>
    </dependency></dependencies></profile></profiles>
    <build>
        <finalName>entity-generation-g1-harness</finalName>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <failIfNoTests>true</failIfNoTests>
                    <forkedProcessTimeoutInSeconds>120</forkedProcessTimeoutInSeconds>
                    <forkedProcessExitTimeoutInSeconds>30</forkedProcessExitTimeoutInSeconds>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <version>3.9.0</version>
                <executions>
                    <execution>
                        <id>g1-consumer-runtime-dependencies</id>
                        <phase>generate-test-resources</phase>
                        <goals><goal>tree</goal></goals>
                        <configuration>
                            <scope>runtime</scope>
                            <outputType>json</outputType>
                            <outputFile>${project.build.directory}/consumer-runtime-dependency-tree.json</outputFile>
                        </configuration>
                    </execution>
                    <execution>
                        <id>g1-consumer-test-classpath</id>
                        <phase>generate-test-resources</phase>
                        <goals><goal>build-classpath</goal></goals>
                        <configuration>
                            <scope>test</scope>
                            <outputFile>${project.build.directory}/consumer-test-classpath.txt</outputFile>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>

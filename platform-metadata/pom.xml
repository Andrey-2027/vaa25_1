<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.0.6</version>
        <relativePath/>
    </parent>

    <groupId>org.ipro</groupId>
    <artifactId>platform-metadata</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>GitVaa platform metadata spine</name>
    <description>
        D2 → D3: позвоночник метаданных, на который упираются платформенные подсистемы —
        скан классов по аннотации и индекс обратных ссылок. Вынесен первым из «среза
        метаданных», потому что замер замыкания показал: numbering тянет из дерева ровно
        один тип (сканер), settings — два (сканер и индекс). Пока эти два типа были в
        дереве, ни одну подсистему нельзя было сделать модулем.
    </description>

    <properties>
        <java.version>21</java.version>
        <maven.compiler.release>21</maven.compiler.release>
        <platform-contracts.version>1.0-SNAPSHOT</platform-contracts.version>
    </properties>

    <!--
      Разрешённые зависимости — reviewed, проверяются PlatformMetadataModuleTest:

      1. platform-contracts — аннотации метаданных (@EntityMetadata, @FieldMetadata,
         @Lookup, @TableSectionMetadata), которые читают оба типа этого модуля.
      2. spring-context — сканер классов (ClassPathScanningCandidateComponentProvider) и
         bean-контракт индекса (@Component/@Value/InitializingBean). Модуль не несёт
         авто-конфигурации: бин ReferenceIndex объявляет MetadataAutoConfiguration
         приложения, поэтому потеря модуля видна компилятору, а не только в рантайме.

      Реализации платформы (data path, crud, rls, telemetry, form) здесь запрещены: этот
      модуль обязан остаться ниже их, иначе подсистемы не смогут зависеть на него без цикла.
    -->
    <dependencies>
        <dependency>
            <groupId>org.ipro</groupId>
            <artifactId>platform-contracts</artifactId>
            <version>${platform-contracts.version}</version>
        </dependency>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-context</artifactId>
        </dependency>
    </dependencies>
</project>

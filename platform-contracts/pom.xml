<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
      Toolchain consistency: слой контрактов собирается теми же плагинами, что и приложение,
      поэтому parent не отличается. Собственный parent платформы появится вместе с её
      отдельным релизным циклом (D3); сейчас важно, чтобы этот артефакт собирался сам по
      себе и не мог видеть ни приложение, ни платформенные реализации.
    -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.0.6</version>
        <relativePath/>
    </parent>

    <groupId>org.ipro</groupId>
    <artifactId>platform-contracts</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>GitVaa platform contracts</name>
    <description>
        D2 (extraction slice контрактов платформы): декларации, которые читают и приложение,
        и платформенные реализации — метаданные сущностей, event/lifecycle SPI и нейтральные
        identifiers. Пакеты контрактов сохранены, поэтому перенос не потребовал правок в коде;
        граница обеспечивается объявленными зависимостями, а не договорённостью.
    </description>

    <properties>
        <java.version>21</java.version>
        <maven.compiler.release>21</maven.compiler.release>
        <crudui.version>1.0-SNAPSHOT</crudui.version>
    </properties>

    <!--
      Слой контрактов не знает ни платформенных реализаций, ни прикладного пакета org.ip.
      Разрешены только два вида зависимости:

      1. Внешний опубликованный API-артефакт (slf4j-api — версия из spring-boot parent).
      2. Нейтральный identifier, который уже опубликован в другом платформенном
         артефакте (crudui-core -> org.ipro.crud.IdentifiableEntity). crudui-core
         объявляет Vaadin as provided, поэтому UI в потребителей контрактов не течёт.

      Любая новая зависимость здесь означает, что в модуль попало не контрактное знание:
      набор объявленных зависимостей зафиксирован ревью и проверяется
      PlatformContractsModuleTest. Перевод IdentifiableEntity в этот модуль — задача
      владельца crudui (вне этого репозитория), зарегистрирована в карте D1/D3.
    -->
    <dependencies>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>
        <dependency>
            <groupId>org.ipro.crudui</groupId>
            <artifactId>crudui-core</artifactId>
            <version>${crudui.version}</version>
        </dependency>
    </dependencies>
</project>

<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.0.6</version>
        <relativePath/>
    </parent>

    <groupId>org.ipro</groupId>
    <artifactId>platform-register</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>GitVaa platform register</name>
    <description>
        D-R (срез S0): декларация регистра и контракт его строки — аннотации, неизменяемый
        descriptor, валидатор декларации, базовые классы обеих схем (периодическая и подчинённая
        регистратору), SliceSpec со своим валидатором, нейтральные ссылки на регистратор и
        охранники строки. Бинов на этом срезе нет: артефакт обязан собираться и подключаться,
        не меняя регистрацию приложения. Замер замыкания показал, что цена выноса — перемещение,
        а не рефакторинг: движок не называет ни одного прикладного типа.
    </description>

    <properties>
        <java.version>21</java.version>
        <maven.compiler.release>21</maven.compiler.release>
        <platform-contracts.version>1.0-SNAPSHOT</platform-contracts.version>
        <platform-persistence.version>1.0-SNAPSHOT</platform-persistence.version>
    </properties>

    <!--
      Разрешённые зависимости — reviewed, проверяются PlatformRegisterModuleTest:

      1. platform-contracts — аннотации метаданных полей (@FieldMetadata, @GridColumn):
         descriptor описывает измерения и ресурсы по метаданным платформы;
      2. platform-persistence — BaseEntity: строки регистра являются сущностями дерева/модуля;
      3. Hibernate — детали прокси-модели (Hibernate.unproxy) и события записи, на которых
         стоит охранник строки подчинённого регистра;
      4. JPA и validation API — аннотации маппинга и Bean Validation.

      Реализации верхних слоёв (data path, form, rls, telemetry, отчёты, UI) запрещены:
      срезы S1–S3 добавляют чтение, запись по ключу и протокол набора владельца, и каждый
      добавляет ровно те зависимости, которые нужны ему, а не все сразу.
    -->
    <dependencies>
        <dependency>
            <groupId>org.ipro</groupId>
            <artifactId>platform-contracts</artifactId>
            <version>${platform-contracts.version}</version>
        </dependency>
        <dependency>
            <groupId>org.ipro</groupId>
            <artifactId>platform-persistence</artifactId>
            <version>${platform-persistence.version}</version>
        </dependency>
        <dependency>
            <groupId>jakarta.persistence</groupId>
            <artifactId>jakarta.persistence-api</artifactId>
        </dependency>
        <dependency>
            <groupId>jakarta.validation</groupId>
            <artifactId>jakarta.validation-api</artifactId>
        </dependency>
        <!-- Охранник подчинённой строки работает с событиями Hibernate и разворачивает прокси. -->
        <dependency>
            <groupId>org.hibernate.orm</groupId>
            <artifactId>hibernate-core</artifactId>
        </dependency>
    </dependencies>
</project>
